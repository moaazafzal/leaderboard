rules_version = '2';
// Security rules for the League module (collection prefix "league" — change if you changed collectionPrefix).
// Deploy with: firebase deploy --only firestore:rules   (or paste into Firebase Console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Player profile: anyone signed in can read (names), only the owner can write.
    match /league_users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }

    // Group counters: a group fills to 30, then the next group starts. Only +1 steps are allowed.
    match /league_counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.group == 0 && request.resource.data.count == 1;
      allow update: if signedIn() && (
           (request.resource.data.group == resource.data.group && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 30)
        || (request.resource.data.group == resource.data.group + 1 && request.resource.data.count == 1 && resource.data.count >= 30));
    }

    // Group members: readable by everyone signed in; each player writes only their own row,
    // XP can only go up, by at most 500 per write (LeagueConfig.maxXpPerUpload).
    match /league_groups/{groupId}/members/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && request.resource.data.xp == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
      allow update: if isMe(uid)
        && request.resource.data.xp is int
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
      allow delete: if false;
    }
  }
}
